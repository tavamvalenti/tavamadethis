{
  "name": "tavamadethis",
  "compatibility_date": "2026-11-01",
  // Only /api/* runs the script (live stats for The Collective chart); everything else is served as plain files.
  "main": "_worker/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Free Workers KV space holding the latest Collective numbers. The STATS_KEY secret lives only in the Cloudflare dashboard.
  "kv_namespaces": [
    { "binding": "STATS", "id": "f946a06420864360b35e258ec22c4298" }
  ],
  "previews": {}
}
